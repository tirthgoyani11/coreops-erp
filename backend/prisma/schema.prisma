// ─── MODELS ────────────────────────────────────────────────────

model Office {
  id                           String               @id @default(uuid())
  name                         String
  code                         String               @unique
  type                         OfficeType           @default(BRANCH)
  parentId                     String?
  parent                       Office?              @relation("OfficeHierarchy", fields: [parentId], references: [id])
  children                     Office[]             @relation("OfficeHierarchy")
  tenantId                     String?
  legalEntityId                String?
  businessUnitId               String?
  tenant                       Tenant?              @relation(fields: [tenantId], references: [id])
  legalEntity                  LegalEntity?         @relation(fields: [legalEntityId], references: [id])
  businessUnit                 BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  // Address
  street                       String?
  city                         String?
  state                        String?
  country                      String?
  postalCode                   String?
  latitude                     Float?
  longitude                    Float?
  // Contact
  phone                        String?
  email                        String?
  website                      String?
  // Currency / locale
  baseCurrency                 String               @default("INR")
  countryCode                  String?
  locationCode                 String?
  // Settings (flattened from embedded)
  maintenanceApprovalThreshold Float                @default(5000)
  autoApproveUnder             Float                @default(1000)
  lowStockThreshold            Int                  @default(10)
  defaultDepreciationMethod    DepreciationMethod   @default(STRAIGHT_LINE)
  isActive                     Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  // Relations
  users                        User[]
  assets                       Asset[]
  inventory                    Inventory[]
  maintenanceTickets           MaintenanceTicket[]
  purchaseOrders               PurchaseOrder[]
  transactions                 Transaction[]
  budgets                      Budget[]
  aiOperations                 AiOperation[]
  glAccounts                   GLAccount[]
  journalEntries               JournalEntry[]
  preventiveSchedules          PreventiveSchedule[]
  documents                    Document[]
  slaPolices                   SLAPolicy[]
  stocktakes                   Stocktake[]
  // Phase 1: CRM
  customers                    Customer[]
  pricingRules                 PricingRule[]
  quotations                   Quotation[]
  salesOrders                  SalesOrder[]
  arInvoices                   ARInvoice[]
  apInvoices                   APInvoice[]
  employees                    Employee[]
  payrollRuns                  PayrollRun[]
  costCenters                  CostCenter[]
  profitCenters                ProfitCenter[]
  dimensionSets                DimensionSet[]
  periodCloseRuns              PeriodCloseRun[]
  consolidationRuns            ConsolidationRun[]
  revenueContracts             RevenueContract[]
  recruitmentPositions         RecruitmentPosition[]
  crmCampaigns                 Campaign[]
  salesTerritories             SalesTerritory[]
  accountPlans                 AccountPlan[]
  partnerChannels              PartnerChannel[]
  learningCourses              LearningCourse[]
  workforcePlans               WorkforcePlan[]
  selfServiceRequests          SelfServiceRequest[]

  @@index([name, country])
  @@index([parentId])
  @@index([type, isActive])
  @@index([tenantId, isActive])
  @@index([legalEntityId])
  @@index([businessUnitId])
}

model User {
  id                    String              @id @default(uuid())
  name                  String
  firstName             String?
  lastName              String?
  email                 String              @unique
  password              String
  role                  UserRole            @default(STAFF)
  officeId              String?
  office                Office?             @relation(fields: [officeId], references: [id])
  tenantId              String?
  legalEntityId         String?
  tenant                Tenant?             @relation(fields: [tenantId], references: [id])
  legalEntity           LegalEntity?        @relation(fields: [legalEntityId], references: [id])
  preferences           Json? // Layout config: [{id: "slas", x:0, y:0, w:6, h:4}, ...]
  // Permissions (flattened)
  canApproveTickets     Boolean             @default(false)
  canManageAssets       Boolean             @default(false)
  canManageInventory    Boolean             @default(false)
  canViewFinancials     Boolean             @default(false)
  canManageUsers        Boolean             @default(false)
  canManageVendors      Boolean             @default(false)
  approvalLimit         Float               @default(0) // -1 = unlimited
  // Account status
  isActive              Boolean             @default(true)
  lastLogin             DateTime?
  failedLoginAttempts   Int                 @default(0)
  lockUntil             DateTime?
  passwordChangedAt     DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  inviteToken           String?
  inviteTokenExpires    DateTime?
  // Profile
  phone                 String?
  avatar                String?
  language              String              @default("en")
  timezone              String              @default("Asia/Kolkata")
  emailNotifications    Boolean             @default(true)
  inAppNotifications    Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  // Relations
  refreshTokens         RefreshToken[]
  createdAssets         Asset[]             @relation("AssetCreator")
  assignedAssets        Asset[]             @relation("AssetAssignee")
  requestedTickets      MaintenanceTicket[] @relation("TicketRequester")
  assignedTickets       MaintenanceTicket[] @relation("TicketAssignee")
  approvedTickets       MaintenanceTicket[] @relation("TicketApprover")
  workLogs              WorkLog[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  requestedPOs          PurchaseOrder[]     @relation("PORequester")
  approvedPOs           PurchaseOrder[]     @relation("POApprover")
  recordedTransactions  Transaction[]
  aiOperations          AiOperation[]       @relation("AiOperationUser")
  aiApprovals           AiOperation[]       @relation("AiOperationApprover")
  stockMovements        StockMovement[]
  createdJournalEntries JournalEntry[]      @relation("JournalEntryCreator")
  expenseClaims         ExpenseClaim[]      @relation("ExpenseEmployee")
  uploadedDocuments     Document[]
  kpiAlerts             KpiAlert[]
  // Finance Relations
  createdAPInvoices     APInvoice[]         @relation("APInvoiceCreator")
  approvedAPInvoices    APInvoice[]         @relation("APInvoiceApprover")
  createdAPPayments     ApPayment[]         @relation("APPaymentCreator")
  approvedAPPayments    ApPayment[]         @relation("APPaymentApprover")
  createdARPayments     ArPayment[]         @relation("ARPaymentCreator")
  approvedARPayments    ArPayment[]         @relation("ARPaymentApprover")
  // Phase 1: CRM
  createdQuotations     Quotation[]         @relation("QuoteCreator")
  createdSalesOrders    SalesOrder[]        @relation("SOCreator")
  employeeProfile       Employee?
  approvedLeaveRequests LeaveRequest[]      @relation("LeaveApprover")
  processedPayrollRuns  PayrollRun[]        @relation("PayrollProcessor")
  ownedPeriodCloseTasks PeriodCloseTask[]
  createdRecruitmentPositions RecruitmentPosition[] @relation("RecruitmentPositionCreator")
  performanceGoalsCreated PerformanceGoal[] @relation("PerformanceGoalCreator")
  performanceReviewsGiven PerformanceReview[] @relation("PerformanceReviewer")
  ownedCampaigns         Campaign[]          @relation("CampaignOwner")
  managedTerritories     SalesTerritory[]    @relation("TerritoryManager")
  accountPlansOwned      AccountPlan[]       @relation("AccountPlanOwner")
  ownedPartnerChannels   PartnerChannel[]    @relation("PartnerChannelOwner")
  objectivesCreated      EmployeeObjective[] @relation("ObjectiveCreator")
  keyResultUpdates       ObjectiveKeyResult[] @relation("KeyResultUpdater")
  createdLearningCourses LearningCourse[]    @relation("LearningCourseCreator")
  learningRequests       LearningEnrollment[] @relation("LearningRequestedBy")
  learningApprovals      LearningEnrollment[] @relation("LearningApprovedBy")
  workforcePlansCreated  WorkforcePlan[]     @relation("WorkforcePlanCreator")
  selfServiceRequestsRaised SelfServiceRequest[] @relation("SelfServiceRequestedBy")
  selfServiceRequestsApproved SelfServiceRequest[] @relation("SelfServiceApprovedBy")

  @@index([role, officeId])
  @@index([officeId])
  @@index([isActive])
  @@index([tenantId, role])
  @@index([legalEntityId])
}

model Employee {
  id             String         @id @default(uuid())
  employeeCode   String         @unique
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id])
  officeId       String
  office         Office         @relation(fields: [officeId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  designation    String?
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ACTIVE)
  dateOfJoining  DateTime
  dateOfExit     DateTime?
  basicSalary    Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payslips       Payslip[]
  performanceGoals PerformanceGoal[]
  performanceReviews PerformanceReview[]
  objectives     EmployeeObjective[]
  learningEnrollments LearningEnrollment[]
  selfServiceRequests SelfServiceRequest[]

  @@index([officeId, status])
  @@index([department])
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  startDate     DateTime
  endDate       DateTime
  totalDays     Float
  reason        String?
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?       @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  approverNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model PayrollRun {
  id              String           @id @default(uuid())
  runCode         String           @unique
  officeId        String
  office          Office           @relation(fields: [officeId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollRunStatus @default(DRAFT)
  grossAmount     Float            @default(0)
  deductionAmount Float            @default(0)
  netAmount       Float            @default(0)
  processedById   String?
  processedBy     User?            @relation("PayrollProcessor", fields: [processedById], references: [id])
  processedAt     DateTime?
  lockedAt        DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payslips        Payslip[]

  @@unique([officeId, periodStart, periodEnd])
  @@index([officeId, status])
}

model Payslip {
  id            String        @id @default(uuid())
  payslipNumber String        @unique
  payrollRunId  String
  payrollRun    PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  status        PayslipStatus @default(GENERATED)
  earnings      Json
  deductions    Json
  grossPay      Float
  netPay        Float
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, status])
  @@index([payrollRunId])
}

model RecruitmentPosition {
  id            String                    @id @default(uuid())
  positionCode  String                    @unique
  officeId      String
  office        Office                    @relation(fields: [officeId], references: [id])
  title         String
  department    String?
  employmentType EmploymentType           @default(FULL_TIME)
  targetHires   Int                       @default(1)
  openingsFilled Int                      @default(0)
  status        RecruitmentPositionStatus @default(OPEN)
  createdById   String?
  createdBy     User?                     @relation("RecruitmentPositionCreator", fields: [createdById], references: [id])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  applications  CandidateApplication[]

  @@index([officeId, status])
  @@index([department])
}

model CandidateApplication {
  id                 String           @id @default(uuid())
  recruitmentPositionId String
  recruitmentPosition RecruitmentPosition @relation(fields: [recruitmentPositionId], references: [id], onDelete: Cascade)
  fullName           String
  email              String?
  phone              String?
  source             String?
  stage              CandidateStage   @default(APPLIED)
  score              Float?
  resumeUrl          String?
  notes              String?
  appliedAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([recruitmentPositionId, stage])
  @@index([appliedAt])
}

model PerformanceGoal {
  id            String               @id @default(uuid())
  employeeId    String
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?                @relation("PerformanceGoalCreator", fields: [createdById], references: [id])
  title         String
  description   String?
  targetValue   Float?
  currentValue  Float                @default(0)
  weight        Float                @default(1)
  status        PerformanceGoalStatus @default(ACTIVE)
  dueDate       DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([employeeId, status])
  @@index([dueDate])
}

model PerformanceReview {
  id            String                 @id @default(uuid())
  employeeId    String
  employee      Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId    String?
  reviewer      User?                  @relation("PerformanceReviewer", fields: [reviewerId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  rating        Float?
  summary       String?
  status        PerformanceReviewStatus @default(DRAFT)
  submittedAt   DateTime?
  acknowledgedAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([employeeId, status])
  @@index([periodStart, periodEnd])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Vendor {
  id             String           @id @default(uuid())
  name           String
  vendorCode     String           @unique
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  gstNumber      String?
  panNumber      String?
  bankDetails    Json? // { bankName, accountNumber, ifscCode }
  rating         Float?           @default(0)
  isBlacklisted  Boolean          @default(false)
  notes          String?
  officeId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // Relations
  purchaseOrders PurchaseOrder[]
  apInvoices     APInvoice[] // Link to AP invoices from this vendor
  assets         Asset[]
  contracts      VendorContract[]

  @@index([name])
  @@index([isBlacklisted])
}

model Asset {
  id                  String                    @id @default(uuid())
  guai                String                    @unique
  name                String
  category            AssetCategory
  manufacturer        String?
  model               String?
  serialNumber        String?
  // Purchase info (flattened)
  vendorId            String?
  vendor              Vendor?                   @relation(fields: [vendorId], references: [id])
  purchaseDate        DateTime                  @default(now())
  purchasePrice       Float
  currency            String                    @default("INR")
  purchaseOrderNumber String?
  invoiceNumber       String?
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  warrantyTerms       String?
  // Depreciation
  depreciationMethod  DepreciationMethod        @default(STRAIGHT_LINE)
  usefulLife          Int                       @default(5)
  salvageValue        Float                     @default(0)
  currentBookValue    Float?
  depreciationRate    Float?
  lastDepCalculated   DateTime?
  // Location
  building            String?
  floor               String?
  room                String?
  assignedToId        String?
  assignedTo          User?                     @relation("AssetAssignee", fields: [assignedToId], references: [id])
  officeId            String
  office              Office                    @relation(fields: [officeId], references: [id])
  status              AssetStatus               @default(ACTIVE)
  condition           AssetCondition            @default(GOOD)
  qrCode              String?
  images              Json? // [{ url, caption, uploadedAt }]
  notes               String?
  createdById         String?
  createdBy           User?                     @relation("AssetCreator", fields: [createdById], references: [id])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  // Relations
  maintenanceTickets  MaintenanceTicket[]
  maintenanceHistory  AssetMaintenanceHistory[]
  preventiveSchedules PreventiveSchedule[]
  documents           Document[]

  @@index([officeId, status])
  @@index([category, status])
  @@index([assignedToId])
  @@index([serialNumber])
  @@index([vendorId])
  @@index([createdAt(sort: Desc)])
}

model AssetMaintenanceHistory {
  id      String   @id @default(uuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date    DateTime @default(now())
  type    String?
  cost    Float    @default(0)
  notes   String?

  @@index([assetId, date(sort: Desc)])
}

model MaintenanceTicket {
  id                    String              @id @default(uuid())
  ticketNumber          String              @unique
  assetId               String
  asset                 Asset               @relation(fields: [assetId], references: [id])
  officeId              String
  office                Office              @relation(fields: [officeId], references: [id])
  issueDescription      String
  issueType             IssueType           @default(OTHER)
  priority              TicketPriority      @default(MEDIUM)
  // Costs
  estimatedCost         Float?
  actualCost            Float?
  currency              String              @default("INR")
  // Algorithm decision (stored as JSON for flexibility)
  algorithmDecision     Json?
  // Approval
  approvalStatus        ApprovalStatus      @default(PENDING)
  approvedById          String?
  approvedBy            User?               @relation("TicketApprover", fields: [approvedById], references: [id])
  approvalDate          DateTime?
  approvalNotes         String?
  // Assignment
  assignedToId          String?
  assignedTo            User?               @relation("TicketAssignee", fields: [assignedToId], references: [id])
  assignedDate          DateTime?
  // Status
  status                TicketStatus        @default(REQUESTED)
  decision              String? // REPAIR or REPLACE
  resolution            String?
  completedDate         DateTime?
  // Requester
  requestedById         String
  requestedBy           User                @relation("TicketRequester", fields: [requestedById], references: [id])
  reportedDate          DateTime            @default(now())
  attachments           String[]            @default([])
  // SLA tracking
  slaResponseDeadline   DateTime?
  slaResolutionDeadline DateTime?
  slaBreached           Boolean             @default(false)
  firstResponseAt       DateTime?
  preventiveScheduleId  String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  // Relations (embedded arrays → tables)
  workLogs              WorkLog[]
  sparePartsUsed        SparePartUsage[]
  preventiveSchedule    PreventiveSchedule? @relation(fields: [preventiveScheduleId], references: [id])

  @@index([assetId, status])
  @@index([requestedById, reportedDate(sort: Desc)])
  @@index([status, priority])
  @@index([approvalStatus])
  @@index([assignedToId, status])
  @@index([officeId, status])
}

model WorkLog {
  id           String            @id @default(uuid())
  ticketId     String
  ticket       MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User              @relation(fields: [technicianId], references: [id])
  startTime    DateTime?
  endTime      DateTime?
  hoursWorked  Float?
  notes        String?
  createdAt    DateTime          @default(now())

  @@index([ticketId])
  @@index([technicianId])
}

model SparePartUsage {
  id          String            @id @default(uuid())
  ticketId    String
  ticket      MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  inventoryId String?
  inventory   Inventory?        @relation(fields: [inventoryId], references: [id])
  partNumber  String?
  name        String?
  quantity    Int
  costPerUnit Float?
  createdAt   DateTime          @default(now())

  @@index([ticketId])
  @@index([inventoryId])
}

model Inventory {
  id                String              @id @default(uuid())
  type              InventoryType
  name              String
  description       String?
  sku               String?             @unique
  partNumber        String?
  category          String?
  subcategory       String?
  officeId          String
  office            Office              @relation(fields: [officeId], references: [id])
  // Storage
  storageLocation   String?
  storageBin        String?
  storageShelf      String?
  // Tracking
  trackingType      TrackingType        @default(QUANTITY)
  // Stock levels
  currentQuantity   Int                 @default(0)
  reorderPoint      Int                 @default(10)
  reorderQuantity   Int                 @default(50)
  maxQuantity       Int?
  minimumQuantity   Int                 @default(5)
  unit              String              @default("pieces")
  // Pricing (products)
  costPrice         Float?
  sellingPrice      Float?
  marginPercentage  Float?
  // Cost info (spares)
  unitCost          Float?
  pricingCurrency   String              @default("INR")
  lastPurchasePrice Float?
  lastPurchaseDate  DateTime?
  lastRestockDate   DateTime?
  // Vendor
  primaryVendorId   String?
  isActive          Boolean             @default(true)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  // Relations
  stockMovements    StockMovement[]
  sparePartUsages   SparePartUsage[]
  poItems           PurchaseOrderItem[]
  batches           InventoryBatch[]
  serializedUnits   SerializedUnit[]
  quotationItems    QuotationItem[]
  salesOrderItems   SalesOrderItem[]

  @@index([officeId, type])
  @@index([category])
  @@index([type, isActive])
}

model StockMovement {
  id            String            @id @default(uuid())
  inventoryId   String
  inventory     Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type          StockMovementType
  quantity      Int
  reason        String?
  reference     String? // PO number, ticket number, etc.
  performedById String?
  performedBy   User?             @relation(fields: [performedById], references: [id])
  date          DateTime          @default(now())

  @@index([inventoryId, date(sort: Desc)])
  @@index([type])
}

model InventoryBatch {
  id                String    @id @default(uuid())
  inventoryId       String
  inventory         Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  batchNumber       String
  lotNumber         String?
  quantity          Int
  remainingQuantity Int
  expiryDate        DateTime?
  manufacturingDate DateTime?
  receivedDate      DateTime  @default(now())
  costPerUnit       Float?
  status            String    @default("AVAILABLE") // AVAILABLE, EXPIRED, CONSUMED, QUARANTINE
  notes             String?
  createdAt         DateTime  @default(now())

  @@unique([inventoryId, batchNumber])
  @@index([expiryDate])
  @@index([status])
}

model SerializedUnit {
  id           String    @id @default(uuid())
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  serialNumber String    @unique
  status       String    @default("IN_STOCK") // IN_STOCK, ISSUED, RETURNED, DEFECTIVE
  batchNumber  String?
  issuedToId   String?
  issuedDate   DateTime?
  returnDate   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([inventoryId, status])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  poNumber             String              @unique
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  officeId             String
  office               Office              @relation(fields: [officeId], references: [id])
  tenantId             String?
  legalEntityId        String?
  fiscalPeriodId       String?
  fiscalPeriod         FiscalPeriod?       @relation(fields: [fiscalPeriodId], references: [id])
  dimensionSetId       String?
  dimensionSet         DimensionSet?       @relation(fields: [dimensionSetId], references: [id])
  requestedById        String
  requestedBy          User                @relation("PORequester", fields: [requestedById], references: [id])
  status               POStatus            @default(DRAFT)
  // Financials
  subtotal             Float?
  taxAmount            Float?
  totalAmount          Float?
  currency             String              @default("INR")
  // Dates
  orderDate            DateTime?
  expectedDeliveryDate DateTime?
  deliveryDate         DateTime?
  // Approval
  approvedById         String?
  approvedBy           User?               @relation("POApprover", fields: [approvedById], references: [id])
  approvalDate         DateTime?
  // 3-way matching
  grnReference         String?
  invoiceReference     String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  // Relations
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  apInvoices           APInvoice[] // 3-way matching: AP Invoices linked to PO
  amendments           POAmendment[]

  @@index([vendorId])
  @@index([officeId, status])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([fiscalPeriodId])
  @@index([dimensionSetId])
  @@index([tenantId])
  @@index([legalEntityId])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryId      String?
  inventory        Inventory?    @relation(fields: [inventoryId], references: [id])
  name             String
  description      String?
  quantity         Int
  unitPrice        Float
  totalPrice       Float?
  receivedQuantity Int           @default(0)

  @@index([purchaseOrderId])
  @@index([inventoryId])
}

model Transaction {
  id             String             @id @default(uuid())
  type           TransactionType
  category       String
  amount         Float
  currency       String             @default("INR")
  date           DateTime           @default(now())
  description    String?
  referenceType  ReferenceType      @default(MANUAL)
  referenceId    String?
  officeId       String?
  office         Office?            @relation(fields: [officeId], references: [id])
  tenantId       String?
  legalEntityId  String?
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id])
  costCenterId   String?
  costCenter     CostCenter?        @relation(fields: [costCenterId], references: [id])
  profitCenterId String?
  profitCenter   ProfitCenter?      @relation(fields: [profitCenterId], references: [id])
  dimensionSetId String?
  dimensionSet   DimensionSet?      @relation(fields: [dimensionSetId], references: [id])
  recordedById   String?
  recordedBy     User?              @relation(fields: [recordedById], references: [id])
  status         TransactionStatus  @default(CLEARED)
  glAccountId    String?
  glAccount      GLAccount?         @relation(fields: [glAccountId], references: [id])
  journalLines   JournalEntryLine[]
  createdAt      DateTime           @default(now())

  @@index([officeId, date(sort: Desc)])
  @@index([type, category])
  @@index([status])
  @@index([glAccountId])
  @@index([fiscalPeriodId])
  @@index([costCenterId])
  @@index([profitCenterId])
  @@index([dimensionSetId])
  @@index([tenantId])
  @@index([legalEntityId])
}

model Budget {
  id             String        @id @default(uuid())
  officeId       String
  office         Office        @relation(fields: [officeId], references: [id])
  tenantId       String?
  legalEntityId  String?
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  dimensionSetId String?
  dimensionSet   DimensionSet? @relation(fields: [dimensionSetId], references: [id])
  category       String
  month          Int
  year           Int
  limit          Float         @default(0)
  spent          Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([officeId, category, month, year])
  @@index([officeId, year, month])
  @@index([fiscalPeriodId])
  @@index([dimensionSetId])
  @@index([tenantId])
  @@index([legalEntityId])
}

model Document {
  id             String   @id @default(uuid())
  name           String
  originalName   String?
  mimeType       String?
  size           Int?
  url            String   @map("path")
  publicId       String?
  category       String?  @default("GENERAL")
  tags           String[] @default([])
  description    String?
  isArchived     Boolean  @default(false)
  officeId       String?
  office         Office?  @relation(fields: [officeId], references: [id])
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
  linkedAssetId  String?
  linkedAsset    Asset?   @relation(fields: [linkedAssetId], references: [id])
  linkedTicketId String?
  ocrText        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([officeId, category])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id           String               @id @default(uuid())
  recipientId  String
  recipient    User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  message      String
  priority     NotificationPriority @default(MEDIUM)
  // Related document
  relatedModel String?
  relatedDocId String?
  actions      Json? // [{ label, action, url }]
  isRead       Boolean              @default(false)
  readAt       DateTime?
  sentAt       DateTime             @default(now())
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([recipientId, isRead, sentAt(sort: Desc)])
  @@index([type])
}

model AuditLog {
  id           String             @id @default(uuid())
  userId       String?
  user         User?              @relation(fields: [userId], references: [id])
  action       AuditAction
  resourceType AuditResourceType?
  resourceId   String?
  changes      Json? // { before, after, fields }
  ipAddress    String?
  userAgent    String?
  status       AuditStatus        @default(SUCCESS)
  errorMessage String?
  description  String?
  sessionId    String?
  timestamp    DateTime           @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([status])
}

model CurrencyRate {
  id             String    @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Float
  source         String?
  fetchedAt      DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([baseCurrency, targetCurrency])
  @@index([baseCurrency])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Counter {
  id        String   @id @default(uuid())
  name      String   @unique
  prefix    String?
  sequence  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model FinanceLog {
  id            String   @id @default(uuid())
  type          String // AP_INVOICE, AR_INVOICE, PAYMENT, etc.
  amount        Float
  currency      String   @default("INR")
  description   String?
  referenceType String?
  referenceId   String?
  officeId      String?
  recordedById  String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([officeId, createdAt(sort: Desc)])
  @@index([type])
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  vendorId      String?
  customerId    String?
  type          String    @default("PURCHASE") // PURCHASE or SALES
  amount        Float
  taxAmount     Float     @default(0)
  totalAmount   Float
  currency      String    @default("INR")
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  ocrData       Json?
  officeId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([officeId, status])
  @@index([dueDate])
}

// ─── GENERAL LEDGER (Phase 2) ───────────────────────────────────

enum GLAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model GLAccount {
  id             String             @id @default(uuid())
  code           String             @unique // "1000", "2100", "4000"
  name           String // "Cash", "Accounts Receivable"
  type           GLAccountType
  parentId       String?
  parent         GLAccount?         @relation("GLHierarchy", fields: [parentId], references: [id])
  children       GLAccount[]        @relation("GLHierarchy")
  description    String?
  isActive       Boolean            @default(true)
  balance        Float              @default(0) // running balance
  normalSide     String             @default("DEBIT") // DEBIT or CREDIT
  officeId       String?
  office         Office?            @relation(fields: [officeId], references: [id])
  tenantId       String?
  legalEntityId  String?
  journalLines   JournalEntryLine[]
  transactions   Transaction[]
  apInvoiceLines APInvoiceLine[] // Link to AP invoice lines
  arInvoiceLines ARInvoiceLine[] // Link to AR invoice lines
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bankStatements BankStatement[]

  @@index([type])
  @@index([parentId])
  @@index([officeId])
  @@index([tenantId])
  @@index([legalEntityId])
}

model JournalEntry {
  id                        String                    @id @default(uuid())
  entryNumber               String                    @unique // "JE-2026-0001"
  date                      DateTime                  @default(now())
  description               String?
  reference                 String? // PO number, invoice ID, etc.
  referenceType             String? // "PURCHASE_ORDER", "INVOICE", "MANUAL"
  status                    JournalStatus             @default(DRAFT)
  totalAmount               Float                     @default(0) // total of one side
  officeId                  String?
  office                    Office?                   @relation(fields: [officeId], references: [id])
  tenantId                  String?
  legalEntityId             String?
  fiscalPeriodId            String?
  fiscalPeriod              FiscalPeriod?             @relation(fields: [fiscalPeriodId], references: [id])
  periodCloseRunId          String?
  periodCloseRun            PeriodCloseRun?           @relation(fields: [periodCloseRunId], references: [id])
  consolidationRunId        String?
  consolidationRun          ConsolidationRun?         @relation(fields: [consolidationRunId], references: [id])
  costCenterId              String?
  costCenter                CostCenter?               @relation(fields: [costCenterId], references: [id])
  profitCenterId            String?
  profitCenter              ProfitCenter?             @relation(fields: [profitCenterId], references: [id])
  dimensionSetId            String?
  dimensionSet              DimensionSet?             @relation(fields: [dimensionSetId], references: [id])
  sourceReferenceType       String?
  sourceReferenceId         String?
  createdById               String?
  createdBy                 User?                     @relation("JournalEntryCreator", fields: [createdById], references: [id])
  lines                     JournalEntryLine[]
  apInvoices                APInvoice[] // Link to AP invoices posted from this JE
  apPayments                ApPayment[] // Link to AP payments posted from this JE
  arPayments                ArPayment[] // Link to AR payments posted from this JE
  eliminationEntries        EliminationEntry[]
  revenueRecognitionEntries RevenueRecognitionEntry[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([date(sort: Desc)])
  @@index([status])
  @@index([officeId, date(sort: Desc)])
  @@index([referenceType, reference])
  @@index([fiscalPeriodId])
  @@index([periodCloseRunId])
  @@index([consolidationRunId])
  @@index([dimensionSetId])
  @@index([tenantId])
  @@index([legalEntityId])
  @@index([sourceReferenceType, sourceReferenceId])
}

model JournalEntryLine {
  id             String        @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        GLAccount     @relation(fields: [accountId], references: [id])
  costCenterId   String?
  costCenter     CostCenter?   @relation(fields: [costCenterId], references: [id])
  profitCenterId String?
  profitCenter   ProfitCenter? @relation(fields: [profitCenterId], references: [id])
  dimensionSetId String?
  dimensionSet   DimensionSet? @relation(fields: [dimensionSetId], references: [id])
  debit          Float         @default(0)
  credit         Float         @default(0)
  description    String?
  transactionId  String? // link back to source transaction
  transaction    Transaction?  @relation(fields: [transactionId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([transactionId])
  @@index([costCenterId])
  @@index([profitCenterId])
  @@index([dimensionSetId])
}

// ─── AI OPERATION (Explainability Audit Trail) ──────────────────

model AiOperation {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation("AiOperationUser", fields: [userId], references: [id])
  sessionId             String?
  intent                AiIntent
  inputSummary          String?
  agentsUsed            String[]          @default([])
  planSteps             Json? // [{ step, action, status, durationMs }]
  anomaliesDetected     Json? // [{ field, zScore, value, threshold, message }]
  confidenceScore       Float?
  selfConsistencyVotes  Json? // [{ voteIndex, decision, confidence }]
  rollbackEvents        Json? // [{ step, reason, rolledBackAt }]
  humanApprovalRequired Boolean           @default(false)
  humanApprovalById     String?
  humanApprovalBy       User?             @relation("AiOperationApprover", fields: [humanApprovalById], references: [id])
  humanApprovalAt       DateTime?
  humanApprovalDecision String? // approved, rejected, modified
  totalDurationMs       Int?
  relatedEntityType     String?
  relatedEntityId       String?
  explanation           Json?
  digitalTwinPreview    Json?
  status                AiOperationStatus @default(AI_PENDING)
  officeId              String?
  office                Office?           @relation(fields: [officeId], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([intent, createdAt(sort: Desc)])
  @@index([relatedEntityType, relatedEntityId])
  @@index([officeId, createdAt(sort: Desc)])
  @@index([confidenceScore])
  @@index([status])
}

// ─── PREVENTIVE MAINTENANCE ─────────────────────────────────────

model PreventiveSchedule {
  id               String              @id @default(uuid())
  name             String
  assetId          String?
  asset            Asset?              @relation(fields: [assetId], references: [id])
  assetCategory    AssetCategory?
  officeId         String
  office           Office              @relation(fields: [officeId], references: [id])
  frequency        ScheduleFrequency
  intervalDays     Int? // For CUSTOM frequency
  description      String?
  checklist        Json? // [{ item, required }]
  priority         TicketPriority      @default(MEDIUM)
  estimatedCost    Float?
  assignedToId     String?
  lastExecuted     DateTime?
  nextDue          DateTime
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // Relations
  generatedTickets MaintenanceTicket[]

  @@index([nextDue, isActive])
  @@index([officeId])
  @@index([assetId])
}

// ─── SLA POLICIES ───────────────────────────────────────────────

model SLAPolicy {
  id                  String         @id @default(uuid())
  name                String
  priority            TicketPriority
  responseTimeHours   Int // Max hours to first response
  resolutionTimeHours Int // Max hours to resolution
  escalationLevels    Json? // [{ afterHours, notifyRole, notifyUserId }]
  officeId            String?
  office              Office?        @relation(fields: [officeId], references: [id])
  isDefault           Boolean        @default(false)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())

  @@index([priority, isActive])
  @@index([officeId])
}

// ─── STOCKTAKE / CYCLE COUNTING ─────────────────────────────────

model Stocktake {
  id          String          @id @default(uuid())
  officeId    String
  office      Office          @relation(fields: [officeId], references: [id])
  status      String          @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt   DateTime?
  completedAt DateTime?
  createdById String
  notes       String?
  items       StocktakeItem[]
  createdAt   DateTime        @default(now())

  @@index([officeId, status])
}

model StocktakeItem {
  id              String    @id @default(uuid())
  stocktakeId     String
  stocktake       Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  inventoryId     String
  systemQuantity  Int
  countedQuantity Int?
  variance        Int?
  notes           String?
  countedAt       DateTime?

  @@index([stocktakeId])
}

// ─── FINANCE ENHANCEMENTS (Phase 4 & 5) ───────────────────────────

model TaxRate {
  id        String   @id @default(uuid())
  name      String // "GST 18%", "IGST 12%", "VAT 5%"
  code      String   @unique // "GST18", "IGST12"
  rate      Float // 18.0, 12.0
  type      String // GST, IGST, SGST, CGST, VAT, CUSTOM
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BankStatement {
  id            String      @id @default(uuid())
  accountId     String
  account       GLAccount   @relation(fields: [accountId], references: [id])
  bankName      String
  accountNumber String
  statementDate DateTime
  entries       BankEntry[]
  uploadedById  String
  officeId      String
  status        String      @default("PENDING") // PENDING, RECONCILED
  createdAt     DateTime    @default(now())

  @@index([officeId, status])
}

model BankEntry {
  id                   String        @id @default(uuid())
  statementId          String
  statement            BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date                 DateTime
  description          String
  amount               Float
  type                 String // DEBIT, CREDIT
  reference            String?
  matchedTransactionId String?
  isReconciled         Boolean       @default(false)

  @@index([statementId])
}

model ExpenseClaim {
  id           String        @id @default(uuid())
  claimNumber  String        @unique
  employeeId   String
  employee     User          @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  officeId     String
  status       String        @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, PAID
  totalAmount  Float         @default(0)
  currency     String        @default("INR")
  description  String?
  items        ExpenseItem[]
  approvedById String?
  approvalDate DateTime?
  paidDate     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([employeeId, status])
  @@index([officeId])
}

model ExpenseItem {
  id          String       @id @default(uuid())
  claimId     String
  claim       ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String // TRAVEL, FOOD, ACCOMMODATION, SUPPLIES, OTHER
  description String
  amount      Float
  receipt     String? // File URL

  @@index([claimId])
}

model VendorContract {
  id             String   @id @default(uuid())
  contractNumber String   @unique
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  officeId       String
  type           String // SERVICE, SUPPLY, MAINTENANCE, LEASE
  startDate      DateTime
  endDate        DateTime
  value          Float?
  currency       String   @default("INR")
  renewalType    String   @default("MANUAL") // AUTO, MANUAL, NONE
  autoRenewDays  Int?
  terms          String?
  attachments    String[]
  status         String   @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, TERMINATED
  reminderDays   Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
  @@index([status, endDate])
}

// ─── PURCHASE REQUISITIONS ──────────────────────────────────────

model PurchaseRequisition {
  id              String    @id @default(uuid())
  prNumber        String    @unique
  requestedById   String
  officeId        String
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, CONVERTED
  priority        String    @default("MEDIUM")
  justification   String?
  requiredByDate  DateTime?
  approvedById    String?
  approvalDate    DateTime?
  convertedToPOId String?
  items           PRItem[]
  totalEstimate   Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([officeId, status])
  @@index([requestedById])
}

model PRItem {
  id                String              @id @default(uuid())
  requisitionId     String
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  inventoryId       String?
  description       String
  quantity          Int
  estimatedPrice    Float?
  suggestedVendorId String?
  notes             String?

  @@index([requisitionId])
}

// ─── RFQ & VENDOR QUOTATIONS ────────────────────────────────────

model RFQ {
  id              String            @id @default(uuid())
  rfqNumber       String            @unique
  title           String
  description     String?
  officeId        String
  requiredByDate  DateTime?
  status          String            @default("DRAFT") // DRAFT, SENT, CLOSED, AWARDED
  items           RFQItem[]
  quotations      VendorQuotation[]
  awardedVendorId String?
  createdById     String
  createdAt       DateTime          @default(now())

  @@index([status])
}

model RFQItem {
  id          String  @id @default(uuid())
  rfqId       String
  rfq         RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unit        String  @default("pieces")
  specs       String?

  @@index([rfqId])
}

model VendorQuotation {
  id          String    @id @default(uuid())
  rfqId       String
  rfq         RFQ       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId    String
  totalAmount Float
  currency    String    @default("INR")
  validUntil  DateTime?
  items       Json? // [{ rfqItemId, unitPrice, totalPrice, notes }]
  attachments String[]
  status      String    @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED
  submittedAt DateTime  @default(now())

  @@index([rfqId, vendorId])
}

// ─── GOODS RECEIPT NOTES ────────────────────────────────────────

model GoodsReceipt {
  id              String        @id @default(uuid())
  grnNumber       String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String
  officeId        String
  status          String        @default("DRAFT") // DRAFT, INSPECTING, ACCEPTED, PARTIAL, REJECTED
  receivedDate    DateTime      @default(now())
  items           GRNItem[]
  apInvoices      APInvoice[] // 3-way matching: GRN linked to AP Invoices
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
}

model GRNItem {
  id               String       @id @default(uuid())
  grnId            String
  grn              GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId         String
  quantityReceived Int
  quantityAccepted Int?
  quantityRejected Int?
  rejectionReason  String?
  batchNumber      String?

  @@index([grnId])
}

// ─── PO AMENDMENTS ──────────────────────────────────────────────

model POAmendment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amendmentNumber Int
  changes         Json // { field, oldValue, newValue }
  reason          String?
  amendedById     String
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
}

// ==========================================
// WORKFLOW ENGINE (PHASE 4)
// ==========================================

model WorkflowRule {
  id           String   @id @default(uuid())
  entityType   String // e.g., 'PURCHASE_ORDER', 'EXPENSE_CLAIM'
  triggerEvent String // e.g., 'ON_CREATE', 'ON_STATUS_CHANGE'
  condition    Json // e.g., { "field": "totalAmount", "operator": ">=", "value": 10000 }
  actionType   String // e.g., 'REQUIRE_APPROVAL'
  actionValue  String // e.g., 'CFO'
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entityType, triggerEvent])
}

// ==========================================
// DYNAMIC CUSTOM FIELDS (PHASE 4)
// ==========================================

model CustomFieldDef {
  id         String   @id @default(uuid())
  entityType String // e.g., 'ASSET', 'VENDOR', 'TICKET'
  name       String // e.g., 'Warranty Provider'
  type       String // 'STRING', 'NUMBER', 'DATE', 'BOOLEAN', 'SELECT'
  isRequired Boolean  @default(false)
  options    Json? // Optional array of choices for 'SELECT' type
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values CustomFieldValue[]

  @@unique([entityType, name])
}

model CustomFieldValue {
  id         String         @id @default(uuid())
  fieldDefId String
  fieldDef   CustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  entityId   String // The ID of the target resource (e.g., Asset UUID)
  value      String // Stored as string globally, parsed on frontend based on type
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fieldDefId, entityId])
  @@index([entityId])
}

// ==========================================
// DASHBOARD PERSONALIZATION (PHASE 5)
// ==========================================

model KpiAlert {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricName String // e.g., 'MAINTENANCE_SLA', 'OPEN_TICKETS'
  condition  String // '>', '<', '=', '>=', '<='
  threshold  Float // e.g., 95 (for 95%)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// SALES & CRM (PHASE 1)
// ==========================================

model Customer {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  company     String?
  address     String?
  gstNumber   String?
  creditLimit Float?   @default(0)
  outstanding Float    @default(0)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  officeId    String
  office      Office   @relation(fields: [officeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations  Quotation[]
  salesOrders SalesOrder[]
  arInvoices  ARInvoice[]
  revenueContracts RevenueContract[]
  accountPlans AccountPlan[]

  @@index([officeId, status])
  @@index([name])
}

model PricingRule {
  id           String          @id @default(uuid())
  name         String
  type         PricingRuleType
  value        Float // 10 for 10% or 100 for $100
  applicableTo String? // 'ALL', 'SPECIFIC_CATEGORY', 'SPECIFIC_CUSTOMER'
  referenceId  String? // categoryId or customerId based on above
  validFrom    DateTime        @default(now())
  validUntil   DateTime?
  isActive     Boolean         @default(true)
  officeId     String
  office       Office          @relation(fields: [officeId], references: [id])
  createdAt    DateTime        @default(now())

  @@index([officeId, isActive])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  officeId        String
  office          Office          @relation(fields: [officeId], references: [id])
  status          QuotationStatus @default(DRAFT)
  totalAmount     Float           @default(0)
  currency        String          @default("INR")
  validUntil      DateTime?
  notes           String?
  createdById     String
  createdBy       User            @relation("QuoteCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@index([customerId, status])
  @@index([officeId])
}

model QuotationItem {
  id          String     @id @default(uuid())
  quotationId String
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  inventoryId String?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])
  description String
  quantity    Int
  unitPrice   Float
  discount    Float      @default(0)
  total       Float

  @@index([quotationId])
}

model SalesOrder {
  id               String           @id @default(uuid())
  orderNumber      String           @unique
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id])
  officeId         String
  office           Office           @relation(fields: [officeId], references: [id])
  quotationId      String?
  quotation        Quotation?       @relation(fields: [quotationId], references: [id])
  status           SalesOrderStatus @default(DRAFT)
  totalAmount      Float            @default(0)
  currency         String           @default("INR")
  expectedDelivery DateTime?
  shippedDate      DateTime?
  notes            String?
  createdById      String
  createdBy        User             @relation("SOCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items      SalesOrderItem[]
  arInvoices ARInvoice[]

  @@index([customerId, status])
  @@index([officeId])
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryId  String?
  inventory    Inventory? @relation(fields: [inventoryId], references: [id])
  description  String
  quantity     Int
  fulfilledQty Int        @default(0)
  unitPrice    Float
  discount     Float      @default(0)
  total        Float

  @@index([salesOrderId])
}

model ARInvoice {
  id             String          @id @default(uuid())
  invoiceNumber  String          @unique
  salesOrderId   String
  salesOrder     SalesOrder      @relation(fields: [salesOrderId], references: [id])
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  officeId       String
  office         Office          @relation(fields: [officeId], references: [id])
  tenantId       String?
  legalEntityId  String?
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id])
  dimensionSetId String?
  dimensionSet   DimensionSet?   @relation(fields: [dimensionSetId], references: [id])
  status         String          @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE
  totalAmount    Float
  amountPaid     Float           @default(0)
  currency       String          @default("INR")
  dueDate        DateTime
  paidDate       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lines          ARInvoiceLine[]
  payments       ArPayment[]

  @@index([customerId, status])
  @@index([officeId])
  @@index([fiscalPeriodId])
  @@index([dimensionSetId])
  @@index([tenantId])
  @@index([legalEntityId])
}

// ─── AP INVOICES (Accounts Payable) ─────────────────────────────

enum APInvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  MATCHED
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
  REJECTED
}

enum InvoiceMatchStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
  OVER_MATCHED
  ERROR
}

model APInvoice {
  id             String             @id @default(uuid())
  invoiceNumber  String             @unique
  poId           String?
  po             PurchaseOrder?     @relation(fields: [poId], references: [id])
  grnId          String?
  grn            GoodsReceipt?      @relation(fields: [grnId], references: [id])
  vendorId       String
  vendor         Vendor             @relation(fields: [vendorId], references: [id])
  officeId       String
  office         Office             @relation(fields: [officeId], references: [id])
  tenantId       String?
  legalEntityId  String?
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id])
  dimensionSetId String?
  dimensionSet   DimensionSet?      @relation(fields: [dimensionSetId], references: [id])
  status         APInvoiceStatus    @default(DRAFT)
  matchStatus    InvoiceMatchStatus @default(UNMATCHED)
  // Amounts
  subtotal       Float              @default(0)
  taxAmount      Float              @default(0)
  totalAmount    Float              @default(0)
  amountPaid     Float              @default(0)
  currency       String             @default("INR")
  // Dates
  invoiceDate    DateTime
  dueDate        DateTime
  paidDate       DateTime?
  // GL Integration
  journalEntryId String?
  journalEntry   JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  // Metadata
  description    String?
  notes          String?
  attachments    String[]
  createdById    String?
  createdBy      User?              @relation("APInvoiceCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?              @relation("APInvoiceApprover", fields: [approvedById], references: [id])
  approvalDate   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Relations
  lines          APInvoiceLine[]
  payments       ApPayment[]
  matchLog       InvoiceMatchLog[]

  @@index([vendorId, status])
  @@index([officeId, invoiceDate(sort: Desc)])
  @@index([status, dueDate])
  @@index([matchStatus])
  @@index([poId])
  @@index([fiscalPeriodId])
  @@index([dimensionSetId])
  @@index([tenantId])
  @@index([legalEntityId])
}

model APInvoiceLine {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     APInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  lineAmount  Float      @default(0)
  // Tax per line
  taxCode     String? // "GST18", "IGST12", etc.
  taxRate     Float      @default(0)
  taxAmount   Float      @default(0)
  // GL Account mapping
  glAccountId String?
  glAccount   GLAccount? @relation(fields: [glAccountId], references: [id])
  // 3-way matching
  poItemId    String?
  grnItemId   String?
  createdAt   DateTime   @default(now())

  @@index([invoiceId])
  @@index([glAccountId])
}

// ─── AR INVOICE ENHANCEMENT ────────────────────────────────────

model ARInvoiceLine {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     ARInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  lineAmount  Float      @default(0)
  // Tax per line
  taxCode     String?
  taxRate     Float      @default(0)
  taxAmount   Float      @default(0)
  // GL Mapping
  glAccountId String?
  glAccount   GLAccount? @relation(fields: [glAccountId], references: [id])
  createdAt   DateTime   @default(now())

  @@index([invoiceId])
}

// ─── PAYMENTS ───────────────────────────────────────────────────

enum PaymentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PROCESSED
  CLEARED
  CANCELLED
  REVERSED
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  CREDIT_CARD
  DIGITAL_WALLET
  OTHER
}

model ApPayment {
  id             String        @id @default(uuid())
  paymentNumber  String        @unique
  invoiceId      String
  invoice        APInvoice     @relation(fields: [invoiceId], references: [id])
  amount         Float
  currency       String        @default("INR")
  paymentDate    DateTime
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String? // Check number, transaction ID, etc.
  status         PaymentStatus @default(DRAFT)
  // GL Integration
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  // Metadata
  notes          String?
  createdById    String?
  createdBy      User?         @relation("APPaymentCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("APPaymentApprover", fields: [approvedById], references: [id])
  approvalDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceId, status])
  @@index([paymentDate(sort: Desc)])
  @@index([status])
}

model ArPayment {
  id             String        @id @default(uuid())
  paymentNumber  String        @unique
  invoiceId      String
  invoice        ARInvoice     @relation(fields: [invoiceId], references: [id])
  amount         Float
  currency       String        @default("INR")
  paymentDate    DateTime
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String? // Check number, transaction ID, etc.
  status         PaymentStatus @default(DRAFT)
  // GL Integration
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  // Metadata
  notes          String?
  createdById    String?
  createdBy      User?         @relation("ARPaymentCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("ARPaymentApprover", fields: [approvedById], references: [id])
  approvalDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceId, status])
  @@index([paymentDate(sort: Desc)])
  @@index([status])
}

// ─── 3-WAY MATCHING LOG ─────────────────────────────────────────

model InvoiceMatchLog {
  id             String    @id @default(uuid())
  invoiceId      String
  invoice        APInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  matchType      String // "PO_MATCH", "GRN_MATCH", "PRICE_VARIANCE", "QTY_VARIANCE"
  status         String // "SUCCESS", "MISMATCH", "TOLERANCE_EXCEEDED"
  variance       Float? // qty or price difference
  toleranceLimit Float? // max allowed variance
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([invoiceId])
  @@index([status])
}

// ─── ENTERPRISE BOUNDARY LAYER (Tier-1 Foundation) ─────────────

model Tenant {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  legalEntities   LegalEntity[]
  businessUnits   BusinessUnit[]
  offices         Office[]
  users           User[]
  fiscalCalendars FiscalCalendar[]
  accountingBooks AccountingBook[]

  @@index([isActive])
}

model LegalEntity {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  countryCode     String?
  baseCurrency    String           @default("INR")
  taxRegistration String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessUnits   BusinessUnit[]
  offices         Office[]
  users           User[]
  fiscalCalendars FiscalCalendar[]
  accountingBooks AccountingBook[]
  revenueContracts RevenueContract[]
  sourceEliminationEntries EliminationEntry[] @relation("EliminationSourceLegalEntity")
  targetEliminationEntries EliminationEntry[] @relation("EliminationTargetLegalEntity")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model BusinessUnit {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  legalEntityId String
  legalEntity   LegalEntity    @relation(fields: [legalEntityId], references: [id])
  code          String
  name          String
  parentId      String?
  parent        BusinessUnit?  @relation("BusinessUnitHierarchy", fields: [parentId], references: [id])
  children      BusinessUnit[] @relation("BusinessUnitHierarchy")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  offices       Office[]

  @@unique([legalEntityId, code])
  @@index([tenantId, legalEntityId])
  @@index([parentId])
}

model FiscalCalendar {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  legalEntityId  String?
  legalEntity    LegalEntity?   @relation(fields: [legalEntityId], references: [id])
  name           String
  yearStartMonth Int            @default(1)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  periods        FiscalPeriod[]

  @@index([tenantId, isActive])
  @@index([legalEntityId])
}

model AccountingBook {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  legalEntityId String
  legalEntity   LegalEntity    @relation(fields: [legalEntityId], references: [id])
  code          String
  name          String
  baseCurrency  String         @default("INR")
  isPrimary     Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  periods       FiscalPeriod[]

  @@unique([legalEntityId, code])
  @@index([tenantId, legalEntityId])
}

model FiscalPeriod {
  id                String             @id @default(uuid())
  fiscalCalendarId  String?
  fiscalCalendar    FiscalCalendar?    @relation(fields: [fiscalCalendarId], references: [id])
  accountingBookId  String?
  accountingBook    AccountingBook?    @relation(fields: [accountingBookId], references: [id])
  code              String
  periodName        String?
  startDate         DateTime
  endDate           DateTime
  status            FiscalPeriodStatus @default(OPEN)
  isAdjustment      Boolean            @default(false)
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  periodCloseRuns   PeriodCloseRun[]
  consolidationRuns ConsolidationRun[]
  revenueSchedules  RevenueSchedule[]
  purchaseOrders    PurchaseOrder[]
  transactions      Transaction[]
  journalEntries    JournalEntry[]
  budgets           Budget[]
  apInvoices        APInvoice[]
  arInvoices        ARInvoice[]

  @@index([startDate, endDate])
  @@index([status])
  @@index([fiscalCalendarId])
  @@index([accountingBookId])
}

// ─── FINANCE DIMENSION & CLOSE CONTROL LAYER ───────────────────

model CostCenter {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  officeId       String?
  office         Office?            @relation(fields: [officeId], references: [id])
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  transactions   Transaction[]
  journalEntries JournalEntry[]
  journalLines   JournalEntryLine[]

  @@index([officeId, isActive])
}

model ProfitCenter {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  officeId       String?
  office         Office?            @relation(fields: [officeId], references: [id])
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  transactions   Transaction[]
  journalEntries JournalEntry[]
  journalLines   JournalEntryLine[]

  @@index([officeId, isActive])
}

model DimensionSet {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  officeId       String?
  office         Office?            @relation(fields: [officeId], references: [id])
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          DimensionSetItem[]
  purchaseOrders PurchaseOrder[]
  transactions   Transaction[]
  journalEntries JournalEntry[]
  journalLines   JournalEntryLine[]
  budgets        Budget[]
  apInvoices     APInvoice[]
  arInvoices     ARInvoice[]

  @@index([officeId, isActive])
}

model DimensionSetItem {
  id             String       @id @default(uuid())
  dimensionSetId String
  dimensionSet   DimensionSet @relation(fields: [dimensionSetId], references: [id], onDelete: Cascade)
  key            String
  value          String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([dimensionSetId, key])
  @@index([dimensionSetId])
}

model PeriodCloseRun {
  id             String               @id @default(uuid())
  runNumber      String               @unique
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod         @relation(fields: [fiscalPeriodId], references: [id])
  officeId       String?
  office         Office?              @relation(fields: [officeId], references: [id])
  status         PeriodCloseRunStatus @default(DRAFT)
  startedAt      DateTime?
  completedAt    DateTime?
  finalizedAt    DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tasks          PeriodCloseTask[]
  journalEntries JournalEntry[]

  @@index([fiscalPeriodId, status])
  @@index([officeId])
}

model PeriodCloseTask {
  id               String                @id @default(uuid())
  periodCloseRunId String
  periodCloseRun   PeriodCloseRun        @relation(fields: [periodCloseRunId], references: [id], onDelete: Cascade)
  taskCode         String
  taskName         String
  status           PeriodCloseTaskStatus @default(PENDING)
  ownerUserId      String?
  ownerUser        User?                 @relation(fields: [ownerUserId], references: [id])
  dueDate          DateTime?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([periodCloseRunId, status])
  @@index([ownerUserId])
}

model ConsolidationRun {
  id                 String                 @id @default(uuid())
  runNumber          String                 @unique
  fiscalPeriodId     String
  fiscalPeriod       FiscalPeriod           @relation(fields: [fiscalPeriodId], references: [id])
  officeId           String?
  office             Office?                @relation(fields: [officeId], references: [id])
  status             ConsolidationRunStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  eliminationEntries EliminationEntry[]
  journalEntries     JournalEntry[]

  @@index([fiscalPeriodId, status])
  @@index([officeId])
}

model EliminationEntry {
  id                  String           @id @default(uuid())
  consolidationRunId  String
  consolidationRun    ConsolidationRun @relation(fields: [consolidationRunId], references: [id], onDelete: Cascade)
  journalEntryId      String?
  journalEntry        JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  sourceLegalEntityId String?
  sourceLegalEntity   LegalEntity?     @relation("EliminationSourceLegalEntity", fields: [sourceLegalEntityId], references: [id])
  targetLegalEntityId String?
  targetLegalEntity   LegalEntity?     @relation("EliminationTargetLegalEntity", fields: [targetLegalEntityId], references: [id])
  description         String?
  amount              Float
  currency            String           @default("INR")
  createdAt           DateTime         @default(now())

  @@index([consolidationRunId])
  @@index([journalEntryId])
  @@index([sourceLegalEntityId])
  @@index([targetLegalEntityId])
}

// ─── REVENUE RECOGNITION CONTRACT LAYER ────────────────────────

model RevenueContract {
  id             String                  @id @default(uuid())
  contractNumber String                  @unique
  customerId     String?
  customer       Customer?               @relation(fields: [customerId], references: [id])
  officeId       String?
  office         Office?                 @relation(fields: [officeId], references: [id])
  legalEntityId  String?
  legalEntity    LegalEntity?            @relation(fields: [legalEntityId], references: [id])
  contractTitle  String?
  startDate      DateTime
  endDate        DateTime?
  totalValue     Float                   @default(0)
  currency       String                  @default("INR")
  status         RevenueContractStatus   @default(DRAFT)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  obligations    PerformanceObligation[]
  schedules      RevenueSchedule[]

  @@index([customerId])
  @@index([officeId])
  @@index([legalEntityId])
  @@index([status])
}

model PerformanceObligation {
  id                String            @id @default(uuid())
  revenueContractId String
  revenueContract   RevenueContract   @relation(fields: [revenueContractId], references: [id], onDelete: Cascade)
  code              String
  name              String
  allocationPercent Float?
  allocatedAmount   Float             @default(0)
  isSatisfied       Boolean           @default(false)
  satisfiedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  revenueSchedules  RevenueSchedule[]

  @@unique([revenueContractId, code])
  @@index([revenueContractId])
}

model RevenueSchedule {
  id                      String                    @id @default(uuid())
  scheduleNumber          String                    @unique
  revenueContractId       String
  revenueContract         RevenueContract           @relation(fields: [revenueContractId], references: [id], onDelete: Cascade)
  performanceObligationId String?
  performanceObligation   PerformanceObligation?    @relation(fields: [performanceObligationId], references: [id])
  fiscalPeriodId          String?
  fiscalPeriod            FiscalPeriod?             @relation(fields: [fiscalPeriodId], references: [id])
  startDate               DateTime
  endDate                 DateTime?
  totalAmount             Float                     @default(0)
  recognizedAmount        Float                     @default(0)
  status                  RevenueScheduleStatus     @default(PLANNED)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  lines                   RevenueScheduleLine[]
  recognitionEntries      RevenueRecognitionEntry[]

  @@index([revenueContractId])
  @@index([performanceObligationId])
  @@index([fiscalPeriodId])
  @@index([status])
}

model RevenueScheduleLine {
  id                String                @id @default(uuid())
  revenueScheduleId String
  revenueSchedule   RevenueSchedule       @relation(fields: [revenueScheduleId], references: [id], onDelete: Cascade)
  milestoneCode     String?
  recognitionDate   DateTime
  amount            Float
  status            RevenueScheduleStatus @default(PLANNED)
  createdAt         DateTime              @default(now())

  @@index([revenueScheduleId, recognitionDate])
}

model RevenueRecognitionEntry {
  id                String          @id @default(uuid())
  revenueScheduleId String
  revenueSchedule   RevenueSchedule @relation(fields: [revenueScheduleId], references: [id], onDelete: Cascade)
  journalEntryId    String?
  journalEntry      JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  recognizedAt      DateTime        @default(now())
  amount            Float
  currency          String          @default("INR")
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([revenueScheduleId])
  @@index([journalEntryId])
}

model Campaign {
  id            String         @id @default(uuid())
  officeId      String
  office        Office         @relation(fields: [officeId], references: [id])
  ownerUserId   String?
  ownerUser     User?          @relation("CampaignOwner", fields: [ownerUserId], references: [id])
  name          String
  objective     String?
  budgetAmount  Float          @default(0)
  leadTarget    Int            @default(0)
  revenueTarget Float          @default(0)
  startDate     DateTime?
  endDate       DateTime?
  status        CampaignStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([officeId, status])
  @@index([ownerUserId])
}

model SalesTerritory {
  id            String          @id @default(uuid())
  officeId      String
  office        Office          @relation(fields: [officeId], references: [id])
  code          String
  name          String
  region        String?
  managerUserId String?
  managerUser   User?           @relation("TerritoryManager", fields: [managerUserId], references: [id])
  status        TerritoryStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([officeId, code])
  @@index([officeId, status])
  @@index([managerUserId])
}

model AccountPlan {
  id              String            @id @default(uuid())
  officeId        String
  office          Office            @relation(fields: [officeId], references: [id])
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  ownerUserId     String?
  ownerUser       User?             @relation("AccountPlanOwner", fields: [ownerUserId], references: [id])
  planName        String
  strategicGoals  String?
  nextQuarterPlan String?
  riskLevel       String?
  reviewDate      DateTime?
  status          AccountPlanStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([officeId, status])
  @@index([customerId])
  @@index([ownerUserId])
}

model PartnerChannel {
  id             String               @id @default(uuid())
  officeId       String
  office         Office               @relation(fields: [officeId], references: [id])
  ownerUserId    String?
  ownerUser      User?                @relation("PartnerChannelOwner", fields: [ownerUserId], references: [id])
  channelName    String
  partnerType    String?
  contactName    String?
  contactEmail   String?
  commissionRate Float                @default(0)
  status         PartnerChannelStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([officeId, status])
  @@index([ownerUserId])
}

model EmployeeObjective {
  id            String          @id @default(uuid())
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?           @relation("ObjectiveCreator", fields: [createdById], references: [id])
  title         String
  description   String?
  startDate     DateTime?
  dueDate       DateTime?
  progress      Float           @default(0)
  status        ObjectiveStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  keyResults    ObjectiveKeyResult[]

  @@index([employeeId, status])
  @@index([dueDate])
}

model ObjectiveKeyResult {
  id               String          @id @default(uuid())
  objectiveId      String
  objective        EmployeeObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title            String
  unit             String?
  targetValue      Float?
  currentValue     Float           @default(0)
  lastUpdatedById  String?
  lastUpdatedBy    User?           @relation("KeyResultUpdater", fields: [lastUpdatedById], references: [id])
  status           KeyResultStatus @default(NOT_STARTED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([objectiveId, status])
}

model LearningCourse {
  id            String               @id @default(uuid())
  officeId      String
  office        Office               @relation(fields: [officeId], references: [id])
  createdById   String?
  createdBy     User?                @relation("LearningCourseCreator", fields: [createdById], references: [id])
  title         String
  provider      String?
  description   String?
  durationHours Float                @default(0)
  status        LearningCourseStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  enrollments   LearningEnrollment[]

  @@index([officeId, status])
  @@index([createdById])
}

model LearningEnrollment {
  id            String                   @id @default(uuid())
  courseId      String
  course        LearningCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?                    @relation("LearningRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                    @relation("LearningApprovedBy", fields: [approvedById], references: [id])
  status        LearningEnrollmentStatus @default(REQUESTED)
  requestedAt   DateTime                 @default(now())
  approvedAt    DateTime?
  completionAt  DateTime?
  score         Float?
  notes         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@index([approvedById])
}

model WorkforcePlan {
  id               String             @id @default(uuid())
  officeId         String
  office           Office             @relation(fields: [officeId], references: [id])
  createdById      String?
  createdBy        User?              @relation("WorkforcePlanCreator", fields: [createdById], references: [id])
  department       String?
  plannedHeadcount Int                @default(0)
  currentHeadcount Int                @default(0)
  hiringNeeded     Int                @default(0)
  targetDate       DateTime?
  status           WorkforcePlanStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([officeId, status])
  @@index([department])
}

model SelfServiceRequest {
  id            String                   @id @default(uuid())
  officeId      String
  office        Office                   @relation(fields: [officeId], references: [id])
  employeeId    String
  employee      Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?                    @relation("SelfServiceRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                    @relation("SelfServiceApprovedBy", fields: [approvedById], references: [id])
  requestType   SelfServiceRequestType
  title         String
  details       String?
  status        SelfServiceRequestStatus @default(PENDING)
  requestedAt   DateTime                 @default(now())
  approvedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([officeId, status])
  @@index([employeeId, status])
  @@index([approvedById])
}
