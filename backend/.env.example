# Backend Environment Variables Template
# Copy this file to .env and configure appropriately

PORT=5000
NODE_ENV=development

# Database — PostgreSQL (Prisma)
# For strongest current behavior, use: sslmode=verify-full
# If you specifically want libpq compatibility semantics, use:
# ...?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/coreops_dev

# JWT Configuration
# IMPORTANT: Generate a secure secret for production (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_64_PLUS_CHARS
JWT_EXPIRES_IN=7d

# CORS - Comma-separated list of allowed origins
# IMPORTANT: Set actual frontend domains in production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Seed Admin Credentials (for initial setup only)
# IMPORTANT: Set these before running seed, then remove or disable
# SEED_ADMIN_EMAIL=admin@yourcompany.com
# SEED_ADMIN_PASSWORD=YourSecurePassword123!
# SEED_ADMIN_NAME=Super Admin

# Production-only settings
# Set ALLOW_SEED=true only when needed, then disable immediately
# ALLOW_SEED=false

# Custom logs directory (defaults to ./logs)
# LOGS_DIR=/var/log/coreops

# AI Models — Kimi K2.5 via NVIDIA NIM (Primary)
# Get your API key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_MODEL=moonshotai/kimi-k2-instruct
KIMI_TIMEOUT=30000

# Mindee OCR — Expense receipt extraction (custom model)
# Set these to enable Mindee for expense receipt scans (ocrTarget=expense_receipt)
MINDEE_API_KEY=
MINDEE_EXPENSE_RECEIPT_MODEL_ID=
# Mindee OCR — Invoice extraction (custom model)
# Set this to enable Mindee for invoice scans (ocrTarget=invoice)
MINDEE_INVOICE_MODEL_ID=

# AI Models — Kaggle GPU (Fallback)
# KAGGLE_INFERENCE_URL=https://your-ngrok-url.ngrok-free.dev

# AI Models — Ollama (Local Fallback)
# OLLAMA_URL=http://localhost:11434
# AI_MODEL_VALIDATION=qwen2.5:1.5b
# AI_MODEL_INTENT=qwen2.5:3b
# AI_MODEL_PLANNING=deepseek-r1:1.5b
# AI_MODEL_VISION=qwen2.5-vl:3b
